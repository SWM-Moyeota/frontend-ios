// 빌드 설정값. Android 의 local.properties → 환경변수 → 기본값 구조를 옮겼다.
// 개인 값은 Secrets.xcconfig 에 적는다 (Secrets.xcconfig.example 참고, git 미추적).

// 백엔드 base URL. 기본값은 운영 서버. xcconfig 에서 // 는 주석이라 $() 로 끊어 적는다.
MOYEOTA_BASE_URL = https:/$()/api.moyeota.co.kr/

// 네이버 지도 NCP Key ID. 비어 있으면 빌드는 되고 지도만 런타임 인증 실패한다.
NAVER_MAPS_CLIENT_ID =

// Mixpanel 프로젝트 토큰. 비어 있으면 행동 이벤트를 보내지 않는다 (docs/ANALYTICS.md).
MIXPANEL_TOKEN =

// Meta(Facebook) 앱 ID. 공개 값이라 여기 둔다. 클라이언트 토큰은 Secrets.xcconfig 의 FACEBOOK_CLIENT_TOKEN.
// 둘 중 하나라도 비면 SDK 를 켜지 않는다 (MetaAdsAttribution.swift).
FACEBOOK_APP_ID = 2448080759263977
FACEBOOK_CLIENT_TOKEN =

// 사용자에게 보이는 버전과 스토어 빌드 번호.
MARKETING_VERSION = 1.0.4
CURRENT_PROJECT_VERSION = 1

GOOGLE_IOS_CLIENT_ID = 568416567998-ict7rqmsprjeo1buffh9v1ahm3pdvbit.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID = 568416567998-gd5lf8u4ohshrar4bjj18nrp8va01vrv.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.568416567998-ict7rqmsprjeo1buffh9v1ahm3pdvbit

#include? "Secrets.xcconfig"
